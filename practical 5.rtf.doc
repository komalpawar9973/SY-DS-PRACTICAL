{\rtf1\ansi\ansicpg1252\deff0\nouicompat\deflang1033{\fonttbl{\f0\froman\fprq2\fcharset0 Times New Roman;}{\f1\fnil\fcharset0 Calibri;}{\f2\fswiss\fcharset0 Calibri;}}
{\*\generator Riched20 10.0.19041}\viewkind4\uc1 
\pard\widctlpar\qc\kerning2\b\f0\fs28 Practical 05\par

\pard\widctlpar\b0\fs24\par
\fs28 Input:\par
#include <iostream>\par
#include <string>\par
using namespace std;\par
\par
\par
class Node \{\par
public:\par
    string page;\par
    Node* next;\par
\par
    Node(string p) \{\par
        page = p;\par
        next = nullptr;\par
    \}\par
\};\par
\par
\par
class LinkedListStack \{\par
private:\par
    Node* top;\par
\par
public:\par
    LinkedListStack() \{\par
        top = nullptr;\par
    \}\par
\par
    bool isEmpty() \{\par
        return top == nullptr;\par
    \}\par
\par
    void push(string page) \{\par
        Node* newNode = new Node(page);\par
\par
        newNode->next = top;\par
        top = newNode;\par
    \}\par
\par
    string pop() \{\par
        if (isEmpty()) \{\par
            return "Stack Underflow";\par
        \}\par
\par
        Node* temp = top;\par
        string page = top->page;\par
\par
        top = top->next;\par
        delete temp;\par
\par
        return page;\par
    \}\par
\par
    string peek() \{\par
        if (isEmpty()) \{\par
            return "";\par
        \}\par
\par
        return top->page;\par
    \}\par
\par
    ~LinkedListStack() \{\par
        while (!isEmpty()) \{\par
            pop();\par
        \}\par
    \}\par
\};\par
\par
int main() \{\par
    LinkedListStack backStack;\par
\par
    string currentPage = "Home";\par
    \par
    cout << "Visiting: " << currentPage << endl;\par
\par
    backStack.push(currentPage);\par
    currentPage = "Google";\par
    cout << "Visiting: " << currentPage << endl;\par
\par
    backStack.push(currentPage);\par
    currentPage = "YouTube";\par
    cout << "Visiting: " << currentPage << endl;\par
\par
    backStack.push(currentPage);\par
    currentPage = "Wikipedia";\par
    cout << "Visiting: " << currentPage << endl;\par
\par
    \par
    cout << "\\nBack button pressed.\\n";\par
\par
    backStack.pop();\par
\par
    currentPage = backStack.peek();\par
\par
    if (!currentPage.empty()) \{\par
        cout << "Current page: " << currentPage << endl;\par
    \}\par
\par
    cout << "\\nBack button pressed.\\n";\par
\par
    backStack.pop();\par
\par
    currentPage = backStack.peek();\par
\par
    if (!currentPage.empty()) \{\par
        cout << "Current page: " << currentPage << endl;\par
    \}\par
\par
    return 0;\par
\}\par
\par
